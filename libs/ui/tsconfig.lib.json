  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "paths": {
      "@cocoar/ui-components": ["../../dist/libs/ui-components/index.d.ts"],
      "@cocoar/ui-menu": ["../../dist/libs/ui-menu/index.d.ts"],
      "@cocoar/ui-overlay": ["../../dist/libs/ui-overlay/index.d.ts"],
