{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "isolatedModules": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "overlay/src/**/*.test.ts",
    "overlay/src/**/*.spec.ts",
    "components/src/**/*.test.ts",
    "components/src/**/*.spec.ts",
    "menu/src/**/*.test.ts",
    "menu/src/**/*.spec.ts",
    "overlay/src/**/*.d.ts",
    "components/src/**/*.d.ts",
    "menu/src/**/*.d.ts"
  ],
  "files": ["src/test-setup.ts"]
}
