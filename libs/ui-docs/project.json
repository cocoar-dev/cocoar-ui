{
  "name": "ui-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-docs/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:documentation"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build", "@cocoar-ui/source:docs:all", "ui-docs:build-lib"],
      "options": {
        "outputPath": "dist/libs/ui-docs",
        "commands": ["nx run ui-docs:build-lib", "node scripts/docs/copy-docs-to-dist.mjs"],
        "parallel": false
      }
    },
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/libs/ui-docs"],
      "options": {
        "outputPath": "dist/libs/ui-docs",
        "main": "libs/ui-docs/src/index.ts",
        "tsConfig": "libs/ui-docs/tsconfig.lib.json",
        "assets": [
          "libs/ui-docs/README.md",
          "libs/ui-docs/package.json",
          {
            "input": "libs/ui-docs/bin",
            "glob": "**/*",
            "output": "bin"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
