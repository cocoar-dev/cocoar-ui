  clear(): void {\\n    this.store.set(new Map());\\n  }\\n}\\n\",\"import { APP_INITIALIZER, EnvironmentProviders, InjectionToken, makeEnvironmentProviders } from '@angular/core';\\nimport { HttpClient } from '@angular/common/http';\\nimport { CoarLocaleService } from './coar-locale.service';\\nimport { CoarLocaleDataLoader, CoarHttpLocaleDataLoader } from './l10n/locale-data-loader';\\nimport { CoarIntlLocaleDataLoader } from './l10n/intl-locale-data-loader';\\nimport { CoarLocaleDataStore } from './l10n/locale-data-store';\\nimport { lastValueFrom, forkJoin } from 'rxjs';\\n\\n/**\\n * Configuration for the locale system.\\n */\\nexport interface CoarLocaleConfig {\\n  /**\\n   * List of available languages in the application.\\n   */\\n  availableLanguages: string[];\\n\\n  /**\\n   * Default language to use on initialization.\\n   */\\n  defaultLanguage: string;\\n}\\n\\n/**\\n * Injection token for locale configuration.\\n */\\nexport const COAR_LOCALE_CONFIG = new InjectionToken<CoarLocaleConfig>('COAR_LOCALE_CONFIG');\\n\\n/**\\n * Injection token for locale data loaders (multi-provider).\\n * Loaders are executed in order and results are deep-merged.\\n * Intl loader is always first (provides complete defaults).\\n */\\nexport const COAR_LOCALE_DATA_LOADERS = new InjectionToken<CoarLocaleDataLoader[]>('COAR_LOCALE_DATA_LOADERS');\\n\\n/**\\n * Provides the core locale system (language management).\\n *\\n * This only provides the language service - no locale data sources.\\n * Add locale data sources separately with:\\n * - `provideCoarIntlLocaleSource()` - Browser Intl API (recommended as first source)\\n * - `provideCoarHttpLocaleSource()` - Load from JSON files\\n * - Custom sources via `COAR_LOCALE_DATA_LOADERS` multi-provider\\n *\\n * Sources are executed in registration order and deep-merged.\\n *\\n * @example\\n * ```ts\\n * // Minimal setup (no formatting data)\\n * provideCoarLocale({\\n *   availableLanguages: ['en', 'de'],\\n *   defaultLanguage: 'en',\\n * })\\n *\\n * // With Intl defaults\\n * provideCoarLocale({...}),\\n * provideCoarIntlLocaleSource(),\\n *\\n * // With Intl + HTTP overrides\\n * provideCoarLocale({...}),\\n * provideCoarIntlLocaleSource(),\\n * provideCoarHttpLocaleSource({\\n *   url: (lang) => `/locales/${lang}.json`\\n * }),\\n * ```\\n */\\nexport function provideCoarLocale(config: CoarLocaleConfig): EnvironmentProviders {\\n  return makeEnvironmentProviders([\\n    {\\n      provide: COAR_LOCALE_CONFIG,\\n      useValue: config,\\n    },\\n    CoarLocaleService,\\n    CoarLocaleDataStore,\\n    {\\n      provide: APP_INITIALIZER,\\n      multi: true,\\n      useFactory: (service: CoarLocaleService) => {\\n        return async () => {\\n          // Preload default language from all sources\\n          try {\\n            await service.setLanguage(config.defaultLanguage);\\n          } catch (error) {\\n            console.warn(`[CoarLocale] Failed to preload locale data for '${config.defaultLanguage}':`, error);\\n          }\\n        };\\n      },\\n      deps: [CoarLocaleService],\\n    },\\n  ]);\\n}\\n\",\"import { CoarLocaleData } from './locale-data';\\n\\n/**\\n * Deep merge utility for locale data.\\n * Later sources override earlier sources at the field level.\\n * \\n * @example\\n * ```ts\\n * const intl = { date: { pattern: 'dd.mm.yyyy', firstDayOfWeek: 1 }, number: {...} };\\n * const http = { date: { firstDayOfWeek: 0 } }; // Only override firstDayOfWeek\\n * \\n * const result = mergeLocaleData([intl, http]);\\n * // Result: { date: { pattern: 'dd.mm.yyyy', firstDayOfWeek: 0 }, number: {...} }\\n * ```\\n */\\nexport function mergeLocaleData(sources: Partial<CoarLocaleData>[]): CoarLocaleData | null {\\n  if (sources.length === 0) return null;\\n\\n  let result: Partial<CoarLocaleData> = {};\\n\\n  for (const source of sources) {\\n    if (!source) continue;\\n\\n    // Merge code\\n    if (source.code) {\\n      result.code = source.code;\\n    }\\n\\n    // Deep merge date\\n    if (source.date) {\\n      result.date = { ...result.date, ...source.date };\\n    }\\n\\n    // Deep merge number\\n    if (source.number) {\\n      result.number = { ...result.number, ...source.number };\\n    }\\n\\n    // Deep merge currency\\n    if (source.currency) {\\n      result.currency = {\\n        ...result.currency,\\n        ...source.currency,\\n        symbols: { ...result.currency?.symbols, ...source.currency.symbols },\\n      };\\n    }\\n\\n    // Deep merge percent\\n    if (source.percent) {\\n      result.percent = { ...result.percent, ...source.percent };\\n    }\\n  }\\n\\n  // Ensure we have at least a code\\n  if (!result.code) return null;\\n\\n  return result as CoarLocaleData;\\n}\\n\\n\",\"import { inject, Injectable, Signal, signal } from '@angular/core';\\nimport { Observable, Subject, lastValueFrom, forkJoin, of } from 'rxjs';\\nimport { COAR_LOCALE_CONFIG, COAR_LOCALE_DATA_LOADERS, type CoarLocaleConfig } from './provide-coar-locale';\\nimport { CoarLocaleDataStore } from './l10n/locale-data-store';\\nimport { CoarLocaleDataLoader } from './l10n/locale-data-loader';\\nimport { mergeLocaleData } from './l10n/merge-locale-data';\\n\\n/**\\n * Core locale service responsible for language management.\\n *\\n * This service manages the current language state and notifies consumers\\n * about language changes. It serves as the single source of truth for\\n * the application's current language.\\n *\\n * Other systems (i18n, localization/formatting) can subscribe to language\\n * changes and react accordingly.\\n *\\n * @example\\n * ```typescript\\n * import { inject } from '@angular/core';\\n * import { CoarLocaleService } from '@cocoar/locale';\\n *\\n * export class MyComponent {\\n *   private readonly locale = inject(CoarLocaleService);\\n *\\n *   constructor() {\\n *     // Get current language\\n *     console.log(this.locale.getCurrentLanguage());\\n *\\n *     // React to changes via Signal\\n *     effect