{
  "name": "ui-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-tokens/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["type:tokens", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/ui-tokens",
        "main": "libs/ui-tokens/src/index.ts",
        "tsConfig": "libs/ui-tokens/tsconfig.lib.json",
        "assets": [
          "libs/ui-tokens/*.md",
          {
            "input": "libs/ui-tokens/src/css",
            "glob": "**/*.css",
            "output": "css"
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
