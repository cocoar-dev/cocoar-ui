{
  "name": "@cocoar/logging",
  "version": "0.0.1",
  "description": "Serilog-style structured logging for TypeScript - designed for monorepos and modern applications",
  "author": "Cocoar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoar-dev/cocoar-ui.git",
    "directory": "src/libs/logging"
  },
  "keywords": [
    "logging",
    "serilog",
