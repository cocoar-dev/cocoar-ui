{
  "name": "showcase-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/showcase-e2e/src",
  "implicitDependencies": ["showcase"],
  "// targets": "to see all targets run: nx show project showcase-e2e --web",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e/run-e2e.mjs",
        "cwd": ".",
        "forwardAllArgs": true
      }
    },
    "e2e-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/e2e/run-e2e.mjs --ui",
        "cwd": ".",
        "forwardAllArgs": true
      }
    }
  }
}
