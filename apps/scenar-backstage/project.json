{
  "name": "scenar-backstage",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "scenar",
  "sourceRoot": "apps/scenar-backstage/src",
  "tags": ["scope:scenar", "type:app"],
  "targets": {
    "generate-registry": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*.scenario.ts",
        "{workspaceRoot}/libs/**/src/**/*.scenario.ts",
        "scenarGeneratorScript"
      ],
      "outputs": ["{projectRoot}/src/app/registry.generated.ts"],
      "options": {
        "command": "node scripts/scenar/generate-registry.mjs",
        "cwd": "."
      }
    },
    "generate-registry:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/scenar/generate-registry.mjs --watch",
        "cwd": "."
      }
    },
    "serve:watch": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx serve scenar-backstage",
          "nx generate-registry:watch scenar-backstage"
        ],
        "parallel": true
      }
    },
    "vite:test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "apps/scenar-backstage/vite.config.mts"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["generate-registry", "scenar-abstractions:build"],
      "options": {
        "outputPath": "dist/apps/scenar-backstage",
        "browser": "apps/scenar-backstage/src/main.ts",
        "tsConfig": "apps/scenar-backstage/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/scenar-backstage/public"
          }
        ],
        "styles": ["apps/scenar-backstage/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["generate-registry"],
      "options": {
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "scenar-backstage:build:production"
        },
        "development": {
          "buildTarget": "scenar-backstage:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "scenar-backstage:build",
        "staticFilePath": "dist/apps/scenar-backstage/browser",
        "spa": true
      }
    }
  }
}
