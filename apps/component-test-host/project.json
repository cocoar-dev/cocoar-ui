{
  "name": "component-test-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/component-test-host/src",
  "tags": [],
  "targets": {
    "check-scenar-scenario-imports": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/scenar-backstage/check-scenar-scenario-imports.mjs",
        "cwd": "."
      }
    },
    "generate-scenar-registry": {
      "executor": "nx:run-commands",
      "dependsOn": ["check-scenar-scenario-imports"],
      "options": {
        "command": "node scripts/scenar-backstage/generate-scenar-registry.mjs",
        "cwd": "."
      }
    },
    "build": {
      "dependsOn": ["generate-scenar-registry"],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/component-test-host",
        "browser": "apps/component-test-host/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/component-test-host/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/component-test-host/public"
          }
        ],
        "styles": ["apps/component-test-host/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "dependsOn": ["generate-scenar-registry"],
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "component-test-host:build:production"
        },
        "development": {
          "buildTarget": "component-test-host:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "component-test-host:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "dependsOn": ["generate-scenar-registry"],
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "component-test-host:build",
        "port": 4300,
        "staticFilePath": "dist/apps/component-test-host/browser",
        "spa": true
      }
    }
  }
}
