  "scripts": {
    "build": "nx run-many -t build",
    "build:icons": "node scripts/icons/build-frontend-icons.mjs",
    "docs:reference": "node scripts/docs/extract-component-api.mjs",
    "test": "nx run-many -t test",
    "test:ci": "nx run-many -t test --ci",
    "lint": "nx run-many -t lint",
    "e2e": "nx run showcase-e2e:e2e",
    "e2e:ui": "nx run showcase-e2e:e2e-ui",
    "start": "nx serve showcase",
    "pack:local": "pnpm run pack:ui-components && pnpm run pack:ui-tokens && pnpm run pack:ui-overlay && pnpm run pack:ui-menu && pnpm run pack:markdown-core && pnpm run pack:markdown-viewer",
    "pack:ui-components": "cd dist/libs/ui-components && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "pack:ui-tokens": "cd dist/libs/ui-tokens && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "pack:ui-overlay": "cd dist/libs/ui-overlay && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "pack:ui-menu": "cd dist/libs/ui-menu && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "pack:markdown-core": "cd dist/libs/markdown-core && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "pack:markdown-viewer": "cd dist/libs/markdown-viewer && pnpm pack --pack-destination ../../../../timetodo/src/frontend/local-packages",
    "install:timetodo": "cd ../timetodo/src/frontend && pnpm add file:local-packages/cocoar-ui-components-0.0.2.tgz file:local-packages/cocoar-ui-tokens-0.0.2.tgz file:local-packages/cocoar-ui-overlay-0.0.2.tgz file:local-packages/cocoar-ui-menu-0.0.1.tgz file:local-packages/cocoar-markdown-core-0.0.2.tgz file:local-packages/cocoar-markdown-viewer-0.0.2.tgz",
    "update:timetodo": "pnpm build && pnpm pack:local && pnpm install:timetodo"
  },
